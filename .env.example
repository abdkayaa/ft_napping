# 42 intra app #79145 (intra > Settings > API)
FT_CLIENT_ID=
FT_CLIENT_SECRET=
# 16/11/2026 secret rotasyonundan sonraki yeni secret (ikisi de denenir)
FT_CLIENT_SECRET_NEXT=
# intra app'e de birebir eklenmeli
FT_REDIRECT_URI=https://SITE-ADRESI/api/auth/callback

# Her biri en az 32 karakter rastgele: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
VOTER_SALT=
SESSION_SECRET=
# Ortak admin şifresi (en az 10 karakter, yoksa admin kapalı)
ADMIN_PASSWORD=

# Boş: yerel PGlite (./.data/pglite). Prod: postgres://... (Neon/Supabase)
DATABASE_URL=

# AI tema analizi: Vercel AI Gateway (varsayılan). DeepSeek için AI_BASE_URL=https://api.deepseek.com/v1, AI_MODEL=deepseek-chat, AI_API_KEY=...
AI_GATEWAY_API_KEY=
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
